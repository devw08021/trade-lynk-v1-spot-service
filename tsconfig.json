{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@controllers/*": [
        "src/controllers/*"
      ],
      "@middlewear/*": [
        "src/middlewear/*"
      ],
      "@mudoles/*": [
        "src/mudoles/*"
      ],
      "@mudoles/*": [
        "src/mudoles/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
    },
    "types": [
      "bun-types",
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}